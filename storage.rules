rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function leader() {
      return signedIn() && profile().role in ['admin', 'coordinator', 'director'];
    }

    match /attendance/{userId}/{fileName} {
      allow write: if signedIn() && request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow read: if signedIn() && (request.auth.uid == userId || leader());
    }

    match /weekly-content/{classId}/{fileName} {
      allow write: if leader() && request.resource.size < 25 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
      allow read: if signedIn() && classId in profile().classIds;
    }

    match /avatars/{userId}/{fileName} {
      allow write: if signedIn() && request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow read: if signedIn();
    }
  }
}
