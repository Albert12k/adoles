rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function roleIs(role) { return signedIn() && profile().role == role && profile().active != false; }
    function admin() { return roleIs('admin'); }
    function coordinatorOf(districtId) { return admin() || (roleIs('coordinator') && profile().districtId == districtId); }
    function directorOf(classId) { return admin() || (roleIs('director') &&
      request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.directorIds); }
    function memberOf(classId) { return signedIn() && classId in profile().classIds; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin() ||
        (resource.data.role == 'student' && resource.data.classIds.hasAny(profile().classIds)));
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'student' && request.resource.data.classIds.size() == 0;
      allow update: if admin() || (request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoUrl', 'status', 'themeColor', 'notificationPreferences', 'quietHours', 'settingsUpdatedAt'])) ||
        (roleIs('coordinator') && resource.data.districtId == profile().districtId &&
          ((resource.data.role == 'student' && request.resource.data.role == 'director') ||
           (resource.data.role == 'director' && request.resource.data.role == 'student')) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'districtId', 'classIds'])) ||
        (roleIs('director') && resource.data.role == 'student' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classIds', 'districtId']) &&
          ((request.resource.data.classIds.toSet().difference(resource.data.classIds.toSet()).size() == 1 &&
            request.resource.data.classIds.hasAny(profile().classIds)) ||
           (resource.data.classIds.toSet().difference(request.resource.data.classIds.toSet()).size() == 1 &&
            resource.data.classIds.hasAny(profile().classIds))));
    }

    match /districts/{districtId} {
      allow read: if signedIn();
      allow write: if admin();
    }

    match /roleRequests/{requestId} {
      allow create: if signedIn() && requestId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedRole in ['director', 'coordinator'] &&
        (request.resource.data.requestedRole == 'director' ||
          (get(/databases/$(database)/documents/coordinatorInvites/$(request.resource.data.inviteCode)).data.active == true &&
           (!('cancelled' in get(/databases/$(database)/documents/coordinatorInvites/$(request.resource.data.inviteCode)).data) ||
            get(/databases/$(database)/documents/coordinatorInvites/$(request.resource.data.inviteCode)).data.cancelled != true) &&
           (!('expiresAt' in get(/databases/$(database)/documents/coordinatorInvites/$(request.resource.data.inviteCode)).data) ||
            get(/databases/$(database)/documents/coordinatorInvites/$(request.resource.data.inviteCode)).data.expiresAt > request.time) &&
           get(/databases/$(database)/documents/coordinatorInvites/$(request.resource.data.inviteCode)).data.districtId == request.resource.data.districtId));
      allow read: if signedIn() && (requestId == request.auth.uid || admin() ||
        (roleIs('coordinator') && resource.data.districtId == profile().districtId));
      allow update: if admin() || (roleIs('coordinator') &&
        resource.data.requestedRole == 'director' &&
        resource.data.districtId == profile().districtId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']) &&
        request.resource.data.reviewedBy == request.auth.uid);
    }

    match /coordinatorInvites/{inviteCode} {
      allow get: if true;
      allow list: if admin();
      allow create, update: if admin();
    }

    match /coordinatorAudit/{auditId} {
      allow read, create: if admin();
    }

    match /classJoinRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.userId == request.auth.uid ||
        roleIs('director') || roleIs('coordinator') || admin());
      allow update: if admin() || roleIs('coordinator') ||
        (roleIs('director') && resource.data.classId in profile().classIds);
    }

    match /classMembers/{memberId} {
      allow read: if admin() || roleIs('coordinator') ||
        (roleIs('director') && resource.data.classId in profile().classIds) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if admin() || roleIs('coordinator') ||
        (roleIs('director') && request.resource.data.classId in profile().classIds);
      allow update: if admin() || roleIs('coordinator') ||
        (roleIs('director') && resource.data.classId in profile().classIds);
    }

    match /leadershipTransfers/{transferId} {
      allow create: if signedIn() && directorOf(request.resource.data.classId) &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.action in ['transfer', 'revoke'];
      allow read: if signedIn() && (resource.data.requestedBy == request.auth.uid || admin() ||
        coordinatorOf(resource.data.districtId));
      allow update: if admin() || (roleIs('coordinator') &&
        resource.data.districtId == profile().districtId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']) &&
        request.resource.data.reviewedBy == request.auth.uid);
    }

    match /churches/{churchId} {
      allow read: if signedIn();
      allow write: if admin() || coordinatorOf(request.resource.data.districtId);
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create: if admin() || coordinatorOf(request.resource.data.districtId);
      allow update: if admin() || coordinatorOf(resource.data.districtId) ||
        (directorOf(classId) && request.resource.data.districtId == resource.data.districtId &&
          request.resource.data.churchId == resource.data.churchId &&
          request.resource.data.directorIds == resource.data.directorIds);
    }

    match /classInvites/{classId} {
      allow read: if directorOf(classId) || admin() ||
        (roleIs('coordinator') && resource.data.districtId == profile().districtId);
      allow create: if admin() || coordinatorOf(request.resource.data.districtId);
      allow update: if admin() || coordinatorOf(resource.data.districtId) || directorOf(classId);
    }

    match /classInviteCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if admin() || coordinatorOf(request.resource.data.districtId);
      allow update: if admin() || coordinatorOf(resource.data.districtId) || directorOf(resource.data.classId);
    }

    match /districtEvents/{eventId} {
      allow read: if signedIn() && (admin() || resource.data.districtId == profile().districtId);
      allow create: if coordinatorOf(request.resource.data.districtId);
      allow update: if coordinatorOf(resource.data.districtId);
    }

    match /classActivities/{activityId} {
      allow read: if signedIn() && (memberOf(resource.data.classId) || directorOf(resource.data.classId));
      allow create: if directorOf(request.resource.data.classId);
      allow update, delete: if directorOf(resource.data.classId);
    }

    match /activityParticipants/{participantId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
        memberOf(request.resource.data.classId) && request.resource.data.status == 'registered' && request.resource.data.points == 0;
      allow update: if signedIn() && ((resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'points', 'registeredAt', 'updatedAt']) &&
        request.resource.data.status in ['registered', 'cancelled'] && request.resource.data.points == 0) ||
        (directorOf(resource.data.classId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'points', 'reviewedBy', 'reviewedAt']) &&
          ((request.resource.data.status == 'attended' && request.resource.data.points == get(/databases/$(database)/documents/classActivities/$(resource.data.activityId)).data.points) ||
           (request.resource.data.status == 'registered' && request.resource.data.points == 0))));
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || directorOf(resource.data.classId));
    }

    match /eventRsvps/{rsvpId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.districtId == profile().districtId && request.resource.data.status in ['confirmed', 'waitlisted'];
      allow read: if signedIn() && (resource.data.userId == request.auth.uid ||
        coordinatorOf(resource.data.districtId));
      allow update: if signedIn() && ((resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'userName', 'confirmedAt', 'updatedAt', 'checkedIn', 'waitlistOrder', 'waitlistPosition']) &&
        request.resource.data.status in ['confirmed', 'waitlisted', 'cancelled']) ||
        (coordinatorOf(resource.data.districtId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'checkedIn', 'checkedInBy', 'checkedInAt', 'promotedBy', 'promotedAt'])));
    }

    match /eventFeedback/{feedbackId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.districtId == profile().districtId &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        get(/databases/$(database)/documents/eventRsvps/$(request.resource.data.eventId + '_' + request.auth.uid)).data.status == 'confirmed';
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || coordinatorOf(resource.data.districtId));
      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId && request.resource.data.eventId == resource.data.eventId &&
        request.resource.data.districtId == resource.data.districtId && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
    }

    match /weeklyContent/{contentId} {
      allow read: if memberOf(resource.data.classId);
      allow create: if directorOf(request.resource.data.classId);
      allow update, delete: if directorOf(resource.data.classId);
    }

    match /studyRecords/{recordId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && memberOf(request.resource.data.classId);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || directorOf(resource.data.classId));
      allow update: if signedIn() && ((resource.data.userId == request.auth.uid &&
        resource.data.evaluation == 'revise' && resource.data.feedbackVisible == true &&
        request.resource.data.feedbackVisible == false && request.resource.data.evaluation == 'resubmitted' &&
        request.resource.data.score == 0 && request.resource.data.previousFeedback == resource.data.feedback &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['summary', 'passage', 'feedbackVisible', 'evaluation', 'previousFeedback', 'score', 'revisionCount', 'revisedAt'])) ||
        directorOf(resource.data.classId));
    }

    match /attendance/{recordId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && memberOf(request.resource.data.classId);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || directorOf(resource.data.classId));
      allow update: if (directorOf(resource.data.classId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt']) &&
        request.resource.data.reviewedBy == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid && resource.data.status == 'rejected' &&
          request.resource.data.status == 'pending' && request.resource.data.userId == resource.data.userId &&
          request.resource.data.classId == resource.data.classId && request.resource.data.week == resource.data.week &&
          request.resource.data.quarter == resource.data.quarter && request.resource.data.year == resource.data.year &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evidenceUrl', 'status', 'createdAt', 'userName', 'districtId', 'ageGroup']));
    }

    match /challenges/{challengeId} {
      allow read: if signedIn() && (memberOf(resource.data.classId) || coordinatorOf(resource.data.districtId));
      allow create: if directorOf(request.resource.data.classId);
      allow update: if (directorOf(resource.data.classId) && request.resource.data.status == resource.data.status &&
        request.resource.data.districtId == resource.data.districtId && request.resource.data.classId == resource.data.classId &&
        request.resource.data.bonusPoints == resource.data.bonusPoints) ||
        (coordinatorOf(resource.data.districtId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']));
    }

    match /scores/{scoreId} {
      allow read: if signedIn();
      allow create: if admin() || coordinatorOf(request.resource.data.districtId);
      allow update, delete: if admin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.read == false &&
        ((directorOf(request.resource.data.classId) &&
          request.resource.data.classId in get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.classIds) ||
         (request.resource.data.type == 'leadership' &&
          coordinatorOf(get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.districtId)) ||
         (request.resource.data.type == 'event' && coordinatorOf(request.resource.data.districtId)));
      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    match /classRankings/{classId} {
      allow read: if signedIn();
    }

    match /engagementAlerts/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin() || roleIs('coordinator') ||
        (roleIs('director') && resource.data.classIds.hasAny(profile().classIds)));
      allow update: if admin() || roleIs('coordinator') ||
        (roleIs('director') && resource.data.classIds.hasAny(profile().classIds));
    }

    match /engagementFollowUps/{followUpId} {
      allow read: if signedIn() && (admin() || directorOf(resource.data.classId));
      allow create: if signedIn() && directorOf(request.resource.data.classId) && request.resource.data.contactedBy == request.auth.uid;
      allow update: if signedIn() && directorOf(resource.data.classId) &&
        request.resource.data.classId == resource.data.classId && request.resource.data.userId == resource.data.userId &&
        request.resource.data.contactedBy == request.auth.uid;
    }

    match /quizzes/{quizId} {
      allow read: if memberOf(resource.data.classId) || directorOf(resource.data.classId) || admin();
      allow create: if directorOf(request.resource.data.classId) || admin();
      allow update, delete: if directorOf(resource.data.classId) || admin();
    }

    match /quizAnswerKeys/{quizId} {
      allow read: if directorOf(resource.data.classId) || admin();
      allow create, update: if directorOf(request.resource.data.classId) || admin();
    }

    match /quizAttempts/{attemptId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid ||
        directorOf(resource.data.classId) || admin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
        memberOf(request.resource.data.classId) && request.resource.data.status == 'pending' &&
        get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.active == true &&
        get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.releaseAt <= request.time.toMillis() &&
        get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.closesAt > request.time.toMillis();
      allow update: if directorOf(resource.data.classId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'score', 'correct', 'correctAnswers', 'totalQuestions', 'resultPublished', 'publishedAt', 'reviewedBy', 'reviewedAt']);
    }

    match /quizRankings/{quizId} {
      allow read: if signedIn() && resource.data.published == true &&
        (memberOf(resource.data.classId) || directorOf(resource.data.classId) || admin());
      allow create, update: if directorOf(request.resource.data.classId) || admin();
    }

    match /publishedClassScores/{scoreId} {
      allow read: if signedIn() && resource.data.districtId == profile().districtId;
      allow create, update: if directorOf(request.resource.data.classId) &&
        request.resource.data.districtId == get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.districtId;
    }

    match /periodClosures/{closureId} {
      allow read: if signedIn() && (memberOf(resource.data.classId) || directorOf(resource.data.classId) || admin() ||
        coordinatorOf(get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.districtId));
      allow create: if directorOf(request.resource.data.classId) || admin();
      allow update: if admin();
    }

    match /flashcards/{flashcardId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
        memberOf(request.resource.data.classId) && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.userId == request.auth.uid ||
        directorOf(resource.data.classId) ||
        (resource.data.status == 'published' && memberOf(resource.data.classId)));
      allow update: if directorOf(resource.data.classId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']);
    }

    match /muralPosts/{postId} {
      allow read: if signedIn() && memberOf(resource.data.classId);
      allow update: if signedIn() && memberOf(resource.data.classId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'updatedAt']);
      allow create: if coordinatorOf(request.resource.data.districtId);
    }

    match /badges/{badgeId} {
      allow read: if signedIn();
    }

    match /hallOfFame/{entryId} {
      allow read: if signedIn();
    }

    match /pushTokens/{userId} {
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['userId', 'expoPushToken', 'platform', 'updatedAt']);
      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'expoPushToken', 'platform', 'updatedAt']);
      allow read: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
