rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function roleIs(role) { return signedIn() && profile().role == role; }
    function admin() { return roleIs('admin'); }
    function coordinatorOf(districtId) { return admin() || (roleIs('coordinator') && profile().districtId == districtId); }
    function directorOf(classId) { return admin() || (roleIs('director') &&
      request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.directorIds); }
    function memberOf(classId) { return signedIn() && classId in profile().classIds; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'student' && request.resource.data.classIds.size() == 0;
      allow update: if admin() || (request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoUrl', 'status'])) ||
        (roleIs('coordinator') && resource.data.role == 'student' &&
          request.resource.data.role == 'director' &&
          request.resource.data.districtId == profile().districtId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'districtId', 'classIds']));
    }

    match /districts/{districtId} {
      allow read: if signedIn();
      allow write: if admin();
    }

    match /roleRequests/{requestId} {
      allow create: if signedIn() && requestId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedRole in ['director', 'coordinator'];
      allow read: if signedIn() && (requestId == request.auth.uid || admin() ||
        (roleIs('coordinator') && resource.data.districtId == profile().districtId));
      allow update: if admin() || (roleIs('coordinator') &&
        resource.data.requestedRole == 'director' &&
        resource.data.districtId == profile().districtId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']) &&
        request.resource.data.reviewedBy == request.auth.uid);
    }

    match /classJoinRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.userId == request.auth.uid ||
        roleIs('director') || roleIs('coordinator') || admin());
      allow update: if roleIs('director') || roleIs('coordinator') || admin();
    }

    match /churches/{churchId} {
      allow read: if signedIn();
      allow write: if admin() || coordinatorOf(request.resource.data.districtId);
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create: if admin() || coordinatorOf(request.resource.data.districtId);
      allow update: if admin() || coordinatorOf(resource.data.districtId) ||
        (directorOf(classId) && request.resource.data.districtId == resource.data.districtId &&
          request.resource.data.churchId == resource.data.churchId &&
          request.resource.data.directorIds == resource.data.directorIds);
    }

    match /classInvites/{classId} {
      allow read: if directorOf(classId) || admin() ||
        (roleIs('coordinator') && resource.data.districtId == profile().districtId);
      allow create: if admin() || coordinatorOf(request.resource.data.districtId);
      allow update: if admin() || coordinatorOf(resource.data.districtId) || directorOf(classId);
    }

    match /weeklyContent/{contentId} {
      allow read: if memberOf(resource.data.classId);
      allow create: if directorOf(request.resource.data.classId);
      allow update, delete: if directorOf(resource.data.classId);
    }

    match /studyRecords/{recordId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && memberOf(request.resource.data.classId);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || directorOf(resource.data.classId));
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || directorOf(resource.data.classId));
    }

    match /attendance/{recordId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && memberOf(request.resource.data.classId);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || directorOf(resource.data.classId));
      allow update: if directorOf(resource.data.classId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']) &&
        request.resource.data.reviewedBy == request.auth.uid;
    }

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow create: if directorOf(request.resource.data.classId);
      allow update: if directorOf(resource.data.classId) &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.districtId == resource.data.districtId &&
        request.resource.data.classId == resource.data.classId &&
        request.resource.data.bonusPoints == resource.data.bonusPoints;
    }

    match /scores/{scoreId} {
      allow read: if signedIn();
      allow write: if admin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    match /classRankings/{classId} {
      allow read: if signedIn();
    }

    match /engagementAlerts/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin() || roleIs('coordinator') ||
        (roleIs('director') && resource.data.classIds.hasAny(profile().classIds)));
      allow update: if admin() || roleIs('coordinator') ||
        (roleIs('director') && resource.data.classIds.hasAny(profile().classIds));
    }

    match /quizzes/{quizId} {
      allow read: if directorOf(resource.data.classId) || admin();
      allow create: if directorOf(request.resource.data.classId) || admin();
      allow update, delete: if directorOf(resource.data.classId) || admin();
    }

    match /quizAttempts/{attemptId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid ||
        directorOf(resource.data.classId) || admin());
    }

    match /muralPosts/{postId} {
      allow read: if signedIn();
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
    }

    match /badges/{badgeId} {
      allow read: if signedIn();
    }

    match /hallOfFame/{entryId} {
      allow read: if signedIn();
    }

    match /pushTokens/{userId} {
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['userId', 'expoPushToken', 'platform', 'updatedAt']);
      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'expoPushToken', 'platform', 'updatedAt']);
      allow read: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
